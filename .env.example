# Optional: leave empty until a Supabase project is available.
# These values are public browser configuration. Never use a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Development/staging origin. HTTPS required outside localhost.
ETLINK_APP_URL=http://localhost:3000
# Legacy flag; abuse protection no longer trusts forwarding headers through this flag.
ETLINK_TRUST_PROXY=false
# Guest-inquiry ingress only. Login uses Supabase Auth APIs and native rate limits.
# Inquiry ingress remains disabled until separately reviewed and configured.
# Server-only: never prefix any of these secrets with NEXT_PUBLIC.
ETLINK_INGRESS_SECRET_KEY=
ETLINK_EDGE_ASSERTION_SECRET=
ETLINK_ABUSE_IDENTITY_SECRET=
# Set true only after provider-native Auth abuse protection has been validated.
ETLINK_AUTH_PROVIDER_PROTECTION_REVIEWED=false
# Synthetic loopback fixtures only; rejected for hosted Supabase/application URLs.
ETLINK_SYNTHETIC_TEST_MODE=false
# Enable hosted trading only after approved migrations and hosted validation.
# Both HTTPS origins must match the app and Supabase URLs above.
ETLINK_PHASE2_ENABLED=false
ETLINK_TRADING_APPROVED_APP_ORIGIN=
ETLINK_TRADING_APPROVED_SUPABASE_ORIGIN=
# Optional, server-only trusted document validator. Leave blank until approved.
# Never prefix this name with NEXT_PUBLIC. Missing configuration disables uploads.
ETLINK_STORAGE_VALIDATOR_SECRET_KEY=
# Email delivery is deliberately disabled in Phase 1. No provider credentials required.
# Optional test setup: server-only staging Auth Admin API; never a publishable key.
ETLINK_STAGING_TEST_SECRET_KEY=
# Transactional delivery requires a separate approval from Auth test emails.
ETLINK_NOTIFICATIONS_ENABLED=false
ETLINK_TRANSACTIONAL_EMAIL_SEND_APPROVED=false
ETLINK_NOTIFICATION_WORKER_SECRET_KEY=
ETLINK_EMAIL_PROVIDER_API_KEY=
ETLINK_EMAIL_FROM=
ETLINK_EMAIL_ALLOWED_RECIPIENTS=
